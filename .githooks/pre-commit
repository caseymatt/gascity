#!/usr/bin/env bash
set -euo pipefail

if git diff --cached --quiet --; then
  exit 0
fi

mapfile -d '' -t staged_go_files < <(
  git diff --cached --name-only -z --no-renames --diff-filter=ACM -- '*.go'
)
staged_web_src=false
if ! git diff --cached --quiet --diff-filter=ACDMRT -- 'internal/api/dashboardspa/web/'; then
  staged_web_src=true
fi
generator_owners=$(make --no-print-directory -s generator-affected LINT_CHANGED_SCOPE=staged)
run_genspec=false
run_genschema=false
while IFS= read -r owner; do
  case "$owner" in
    ./cmd/genspec) run_genspec=true ;;
    ./cmd/genschema) run_genschema=true ;;
  esac
done <<< "$generator_owners"

if (( ${#staged_go_files[@]} > 0 )); then
  printf '%s\0' "${staged_go_files[@]}" | scripts/precommit-format-staged-go
  git add -- "${staged_go_files[@]}"

  make lint-changed LINT_CHANGED_SCOPE=staged LINT_FLAGS="--new-from-rev=HEAD --whole-files --fix"
  git add -- "${staged_go_files[@]}"
fi

if [ "$run_genspec" = true ]; then
  go run ./cmd/genspec
  git add -- \
    internal/api/openapi.json \
    docs/reference/schema/openapi.json \
    docs/reference/schema/openapi.txt \
    docs/reference/schema/events.json \
    docs/reference/schema/events.txt
fi

# Re-read the index after genspec. Regenerate the Go client when its spec,
# generator, directive, or committed output changes.
spec_changed=false
if ! git diff --cached --quiet --diff-filter=ACDMRT -- internal/api/openapi.json; then
  spec_changed=true
fi
run_genclient=$spec_changed
if ! git diff --cached --quiet --diff-filter=ACDMRT -- \
  cmd/gen-client/ \
  scripts/gen-client.sh \
  internal/api/genclient/doc.go \
  internal/api/genclient/client_gen.go; then
  run_genclient=true
fi
if [ "$run_genclient" = true ]; then
  go generate ./internal/api/genclient
  git add -- internal/api/genclient/client_gen.go
fi

if [ "$run_genschema" = true ]; then
  go run ./cmd/genschema
  git add -- \
    docs/reference/schema/city-schema.json \
    docs/reference/schema/city-schema.txt \
    docs/reference/schema/pack-schema.json \
    docs/reference/schema/pack-schema.txt \
    docs/reference/config.md \
    docs/reference/cli.md
fi

# The selector reads the complete staged diff, includes reverse dependents, and
# falls back to ./... whenever it cannot prove a bounded package set.
make vet-affected LINT_CHANGED_SCOPE=staged

# Re-read after generation so Go-only schema changes validate their newly
# staged reference documentation.
if ! git diff --cached --quiet --diff-filter=ACDMRT -- \
  '*.md' docs/ engdocs/ plans/ specs/ AGENTS.md CONTRIBUTING.md README.md TESTING.md; then
  make check-docs
fi

# Dashboard SPA rebuild: when internal/api/openapi.json changes, regenerate
# the generated TS API client from the new spec and stage it. When the spec
# OR the SPA source changes, typecheck and rebuild the compiled bundle.
if [ "$spec_changed" = true ] || [ "$staged_web_src" = true ]; then
  if command -v npm >/dev/null 2>&1; then
    if [ "$spec_changed" = true ]; then
      # Regenerate BEFORE typecheck/build below: a client that no longer
      # matches the new spec must fail typecheck immediately instead of
      # silently building/committing a stale client (#4627, #4607).
      (cd internal/api/dashboardspa/web && npm ci --silent && npm run generate:client)
      git add -- internal/api/dashboardspa/web/shared/src/generated/gc-supervisor-client
    fi
    # Typecheck BEFORE build: vite's build transpiles TS to JS and silently
    # ignores type errors. These targets also run the Vitest suite, build dist/,
    # and smoke-run the compiled SPA via Vite preview.
    make dashboard-check dashboard-smoke
    git add -- internal/api/dashboardspa/dist
  else
    if [ "$spec_changed" = true ]; then
      echo "error: internal/api/openapi.json is staged but npm is not on PATH — the generated TS API client" >&2
      echo "cannot be regenerated, so this commit would ship a stale client with no enforcement until CI runs." >&2
      echo "Install Node/npm, or regenerate manually:" >&2
      echo "  cd internal/api/dashboardspa/web && npm ci && npm run generate:client" >&2
      exit 1
    fi
    echo "warning: npm not on PATH — skipped dashboard SPA typecheck + rebuild. CI will enforce this." >&2
  fi
fi
