#!/usr/bin/env bash
set -euo pipefail

# Run only tests owned by the exact surface being pushed. Existing remote
# branches provide an authoritative base SHA on stdin. New branches use the
# merge base with the locally fetched remote default branch. A genuinely empty
# remote uses Git's empty tree as its exact base. Unreachable or unfetched
# non-empty remotes fail closed instead of selecting an unrelated subset.
#
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref
# on stdin (see githooks(5)).

zero="0000000000000000000000000000000000000000"
remote_name="${1:-origin}"
remote_url="${2:-$remote_name}"
ranges=()
any_non_deletion=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Branch deletion — nothing to test, nothing to guard.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  any_non_deletion=1

  base_sha="$remote_sha"
  if [ "$remote_sha" = "$zero" ]; then
    remote_head="$(git symbolic-ref --quiet "refs/remotes/$remote_name/HEAD" 2>/dev/null || true)"
    if [ -z "$remote_head" ]; then
      for candidate in "refs/remotes/$remote_name/main" "refs/remotes/$remote_name/master"; do
        if git rev-parse --verify --quiet "$candidate^{commit}" >/dev/null; then
          remote_head="$candidate"
          break
        fi
      done
    fi
    if [ -z "$remote_head" ]; then
      if ! remote_listing="$(git ls-remote "$remote_url" HEAD 2>/dev/null)"; then
        echo "pre-push: cannot read $remote_name's default branch" >&2
        exit 1
      fi
      if [ -z "$remote_listing" ]; then
        base_sha="$(git hash-object -t tree /dev/null)"
      else
        read -r remote_head _ <<<"$remote_listing"
      fi
    fi
    if [ -n "$remote_head" ]; then
      if ! git cat-file -e "$remote_head^{commit}" 2>/dev/null ||
        ! base_sha="$(git merge-base "$local_sha" "$remote_head")"; then
        echo "pre-push: cannot resolve a stable base for new ref $_local_ref" >&2
        echo "pre-push: fetch $remote_name's default branch, then retry" >&2
        exit 1
      fi
    fi
  fi
  ranges+=("$base_sha:$local_sha")
done

# Bead ownership/staleness guard (ga-fip9ps.1): re-checks bd claim state
# immediately before this push leaves the machine, once per invocation
# (not per ref) regardless of whether Go sources changed. A mayor ruling
# (reassign/close/hold/reroute) that landed after this push was queued
# must not be allowed to clobber a branch another agent has since taken
# over. Bypass: `git push --no-verify`.
if [ "$any_non_deletion" -eq 1 ]; then
  repo_root="$(git rev-parse --show-toplevel)"
  # shellcheck source=../scripts/push-ownership-guard.sh disable=SC1091
  . "$repo_root/scripts/push-ownership-guard.sh"
  if ! assert_bead_still_claimed; then
    exit 1
  fi
fi

for range in "${ranges[@]}"; do
  IFS=: read -r base_sha head_sha <<<"$range"
  echo "pre-push: testing changed surface $base_sha..$head_sha"
  LINT_CHANGED_SCOPE=tracked \
    LINT_CHANGED_REF="$base_sha" \
    LINT_CHANGED_HEAD="$head_sha" \
    make test-affected
done
