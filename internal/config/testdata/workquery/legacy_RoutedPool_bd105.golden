sh -c 'case "$GC_SESSION_ORIGIN" in ephemeral|"") ;; *) if [ -n "$gc_ready_reader_failed" ]; then printf "%s\n" "work query: ready reader failed" >&2; exit 1; fi; exit 0 ;; esac; probe_pool_demand() { target="$1"; [ -z "$target" ] && return 1; r=$(bd ready --include-ephemeral --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --sort oldest --limit=20 2>/dev/null) && gc_ready_reader_failed= || { gc_ready_reader_failed=1; r=; }; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_candidates=$(bd ready --include-ephemeral --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --sort oldest --limit=20 2>/dev/null) && gc_ready_reader_failed= || { gc_ready_reader_failed=1; legacy_candidates=; }; r=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select((.metadata["gc.routed_to"] // "") == "")] | .[:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_ephemeral_candidates=$(printf "[]"); r=$(printf "%s" "$legacy_ephemeral_candidates" | jq '\''.[0:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; return 1; }; probe_pool_demand "$1"; probe_pool_demand "$2"; if [ -n "$gc_ready_reader_failed" ]; then printf "%s\n" "work query: ready reader failed" >&2; exit 1; fi; printf "[]"' -- rig/control-dispatcher rig/workflow-control