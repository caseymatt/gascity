sh -c 'for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; legacy=""; case "$id" in *control-dispatcher) legacy="${id%control-dispatcher}workflow-control";; esac; for cand in "$id" "$legacy"; do [ -z "$cand" ] && continue; r=$(gc ready --include-ephemeral --assignee="$cand" --json --limit=1) || exit $?; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; done; done; if [ -n "$gc_ready_reader_failed" ]; then printf "%s\n" "work query: ready reader failed" >&2; exit 1; fi; printf "[]"'